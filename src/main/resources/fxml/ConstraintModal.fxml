<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.app.controller.ConstraintModalController"
      stylesheets="@../css/style.css"
      prefWidth="350" prefHeight="400"> <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>

    <Label text="Add Constraint" styleClass="header-title"/>
    <Label fx:id="lblCourse" text="Course: CS101" styleClass="label-muted"/>

    <Separator/>

    <Label text="Rule Type:"/>
    <ComboBox fx:id="comboType" maxWidth="Infinity"/>

    <StackPane VBox.vgrow="ALWAYS">
        
        <VBox fx:id="panelTime" spacing="10" visible="false">
            <Label text="Select Days:" style="-fx-font-weight: bold;"/>
             <FlowPane fx:id="flowDays" hgap="8" vgap="4"/>
             <GridPane hgap="8" vgap="4">
                <Label text="Start:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="label-muted"/>
                <Spinner fx:id="spinStart" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <Label text="End:" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="label-muted"/>
                <Spinner fx:id="spinEnd" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
             </GridPane>
        </VBox>

        <VBox fx:id="panelRooms" spacing="10" visible="false">
            <Label text="Forbidden Rooms:" style="-fx-font-weight: bold;"/>
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color:transparent;">
                <content>
                    <VBox fx:id="vboxRoomCheckboxes" spacing="4" style="-fx-padding: 5;"/>
                </content>
            </ScrollPane>
        </VBox>
    </StackPane>
    
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel" onAction="#handleCancel" styleClass="button-base"/>
        <Button text="Add Rule" onAction="#handleSave" styleClass="button-success"/>
    </HBox>
</VBox>