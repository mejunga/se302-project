<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.app.controller.ConstraintModalController"
      prefWidth="400" prefHeight="450">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <Label text="Add Constraint" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    
    <Label fx:id="lblCourse" text="Course: CS101" style="-fx-text-fill: #7f8c8d;"/>

    <Separator/>

    <Label text="Rule Type:"/>
    <ComboBox fx:id="comboType" maxWidth="Infinity"/>

    <StackPane VBox.vgrow="ALWAYS">
        
        <VBox fx:id="panelTime" spacing="10" visible="false">
            <Label text="Select Days:" style="-fx-font-weight: bold;"/>
             <FlowPane fx:id="flowDays" hgap="10" vgap="5"/>
             <GridPane hgap="10" vgap="5">
                <Label text="Start:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <Spinner fx:id="spinStart" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <Label text="End:" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Spinner fx:id="spinEnd" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
             </GridPane>
        </VBox>

        <VBox fx:id="panelRooms" spacing="10" visible="false">
            <Label text="Select Rooms (Tick to include):" style="-fx-font-weight: bold;"/>
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color:transparent;">
                <content>
                    <VBox fx:id="vboxRoomCheckboxes" spacing="5" style="-fx-padding: 5;"/>
                </content>
            </ScrollPane>
        </VBox>
    </StackPane>
    
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel" onAction="#handleCancel"/>
        <Button text="Add Rule" onAction="#handleSave" style="-fx-background-color: #27ae60; -fx-text-fill: white;"/>
    </HBox>
</VBox>