<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.app.controller.ExamCardController"
      fx:id="cardRoot"
      spacing="2" 
      alignment="CENTER_LEFT"
      maxWidth="Infinity" maxHeight="Infinity"
      styleClass="exam-card"
      stylesheets="@../css/style.css">

    <padding>
        <Insets top="4" right="6" bottom="4" left="6"/>
    </padding>

    <Label fx:id="lblCourseCode" text="CODE" styleClass="exam-card-title"/>
    
    <Label fx:id="lblRoomInfo" text="Room" wrapText="true" VBox.vgrow="ALWAYS" maxHeight="Infinity" alignment="TOP_LEFT" styleClass="exam-card-text"/>
    
    <Label fx:id="lblTimeInfo" text="00:00 - 00:00" styleClass="exam-card-time"/>

</VBox>