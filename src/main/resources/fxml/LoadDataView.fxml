<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.app.controller.LoadDataController"
      stylesheets="@../css/style.css"
      spacing="15.0" alignment="TOP_CENTER"
      style="-fx-background-color: white;">

    <padding>
        <Insets top="20" right="30" bottom="20" left="30"/>
    </padding>

    <VBox spacing="2" alignment="CENTER_LEFT" maxWidth="750">
        <Label text="Step 1: Import Data" styleClass="header-title"/>
        <Label text="Please select the individual CSV files for each category." styleClass="label-muted"/>
    </VBox>

    <Separator maxWidth="750" />

    <GridPane hgap="10" vgap="10" maxWidth="750">
        <columnConstraints>
            <ColumnConstraints minWidth="80" halignment="RIGHT"/> <ColumnConstraints hgrow="ALWAYS"/> <ColumnConstraints minWidth="80"/> 
        </columnConstraints>

        <Label text="Students:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <TextField fx:id="txtStudentsPath" promptText="Select students.csv..." editable="false" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Button text="Browse" onAction="#browseStudents" styleClass="button-base, button-small" GridPane.rowIndex="0" GridPane.columnIndex="2"/>

        <Label text="Courses:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <TextField fx:id="txtCoursesPath" promptText="Select courses.csv..." editable="false" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Button text="Browse" onAction="#browseCourses" styleClass="button-base, button-small" GridPane.rowIndex="1" GridPane.columnIndex="2"/>

        <Label text="Rooms:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <TextField fx:id="txtRoomsPath" promptText="Select rooms.csv..." editable="false" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Button text="Browse" onAction="#browseRooms" styleClass="button-base, button-small" GridPane.rowIndex="2" GridPane.columnIndex="2"/>

        <Label text="Attendance:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <TextField fx:id="txtAttendancePath" promptText="Select attendance.csv..." editable="false" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        <Button text="Browse" onAction="#browseAttendance" styleClass="button-base, button-small" GridPane.rowIndex="3" GridPane.columnIndex="2"/>
    </GridPane>

    <Button text="LOAD ALL DATA" onAction="#handleLoad" fx:id="btnLoad"
            styleClass="button-success" maxWidth="250"/>

    <Separator maxWidth="750" />

    <HBox spacing="15" alignment="CENTER" maxWidth="750">
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="2">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <Label text="Students" styleClass="label-muted"/>
            <Label fx:id="lblStudentCount" text="0" styleClass="stat-count"/>
        </VBox>

        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="2">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <Label text="Courses" styleClass="label-muted"/>
            <Label fx:id="lblCourseCount" text="0" styleClass="stat-count"/>
        </VBox>

        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="2">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <Label text="Rooms" styleClass="label-muted"/>
            <Label fx:id="lblRoomCount" text="0" styleClass="stat-count"/>
        </VBox>
    </HBox>

    <VBox maxWidth="750" spacing="2" VBox.vgrow="ALWAYS">
        <Label text="Process Log:" styleClass="label-muted" style="-fx-font-weight: bold;"/>
        <TextArea fx:id="logArea" editable="false" wrapText="true" styleClass="log-area" VBox.vgrow="ALWAYS"/>
    </VBox>
</VBox>