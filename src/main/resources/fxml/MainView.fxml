<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="mainBorderPane" 
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            stylesheets="@../css/style.css"
            fx:controller="com.app.controller.MainController"
            prefHeight="650.0" prefWidth="950.0"> <fx:define>
        <ToggleGroup fx:id="navGroup" />
    </fx:define>
    
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="top-bar">
            <children>
                <Label text="Exam Scheduler" textFill="white">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>

                <Region HBox.hgrow="ALWAYS" />

                <Button text="User Manual / Help" onAction="#handleOpenUserManual"
                        style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7; -fx-border-color: #7f8c8d; -fx-border-radius: 3; -fx-cursor: hand; -fx-font-size: 11px;">
                    <tooltip>
                        <Tooltip text="Click to open documentation PDF"/>
                    </tooltip>
                </Button>
            </children>
        </HBox>
    </top>

    <left>
        <VBox spacing="0" styleClass="sidebar">
            <children>
                <ToggleButton fx:id="btnData" text="1. Load Data" 
                              maxWidth="Infinity" alignment="CENTER_LEFT"
                              onAction="#showDataView"
                              toggleGroup="$navGroup"
                              styleClass="sidebar-button">
                    <padding><Insets top="12" right="10" bottom="12" left="15"/></padding>
                </ToggleButton>

                <ToggleButton fx:id="btnConfig" text="2. Configuration" 
                              maxWidth="Infinity" alignment="CENTER_LEFT"
                              onAction="#showConfigView"
                              toggleGroup="$navGroup"
                              styleClass="sidebar-button">
                    <padding><Insets top="12" right="10" bottom="12" left="15"/></padding>
                </ToggleButton>

                <ToggleButton fx:id="btnSchedule" text="3. View Schedule" 
                              maxWidth="Infinity" alignment="CENTER_LEFT"
                              onAction="#showScheduleView"
                              toggleGroup="$navGroup"
                              styleClass="sidebar-button">
                    <padding><Insets top="12" right="10" bottom="12" left="15"/></padding>
                </ToggleButton>
                
                <Region VBox.vgrow="ALWAYS" />
            </children>
        </VBox>
    </left>

    <center>
        </center>

    <bottom>
        <HBox styleClass="footer">
            <children>
                <Label fx:id="statusLabel" text="Ready" textFill="#7f8c8d" style="-fx-font-size: 11px;"/>
            </children>
        </HBox>
    </bottom>

</BorderPane>