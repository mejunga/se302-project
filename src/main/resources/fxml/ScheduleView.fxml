<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.app.controller.ScheduleController"
            stylesheets="@../css/style.css"
            prefHeight="600.0" prefWidth="1000.0">

    <left>
        <VBox spacing="5" prefWidth="220" styleClass="sidebar-panel">
            <Label text="Generated Schedules" styleClass="section-title"/>
            <ListView fx:id="scheduleListView" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-border-color: #dee2e6;"/>
        </VBox>
    </left>

    <center>
        <VBox>
            <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 8; -fx-background-color: #fff; -fx-border-color: #dee2e6; -fx-border-width: 0 0 1 0;" minHeight="40.0">
                <Label fx:id="lblSelectedSchedule" text="No Schedule Selected" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            </HBox>

            <TabPane fx:id="roomTabPane" tabClosingPolicy="UNAVAILABLE" 
                     style="-fx-background-color: #f4f6f7;"
                     minHeight="38.0" />

            <ScrollPane fx:id="scrollPane" fitToWidth="false" fitToHeight="false" VBox.vgrow="ALWAYS" style="-fx-background: #f4f6f7;">
                <content>
                    <VBox fx:id="mainContainer" spacing="0">
                        <HBox alignment="TOP_LEFT">
                             <Pane fx:id="spacerPane" /> 
                             <HBox fx:id="dayHeaderBox" style="-fx-background-color: white;"/>
                        </HBox>
                        <HBox alignment="TOP_LEFT">
                            <Pane fx:id="timeRulerPane" style="-fx-background-color: #f8f9fa;"/>
                            <StackPane alignment="TOP_LEFT">
                                <Pane fx:id="gridLinesPane" />
                                <Pane fx:id="eventsPane" />
                            </StackPane>
                        </HBox>
                    </VBox>
                </content>
            </ScrollPane>
        </VBox>
    </center>

    <bottom>
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="top-bar" style="-fx-background-color: #34495e;" minHeight="40.0">
            
            <Label fx:id="lblStatus" text="Ready" style="-fx-font-weight: bold; -fx-text-fill: white; -fx-font-size: 11px;"/>
            
            <Region HBox.hgrow="ALWAYS" />
            
            <Button fx:id="btnPrintSelected" text="Export PDF" onAction="#handlePrintSelected"
                    style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 5 15; -fx-font-size: 11px;"/>
        </HBox>
    </bottom>

</BorderPane>