<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.app.controller.ScheduleController"
            prefHeight="700.0" prefWidth="1200.0">

    <left>
        <VBox spacing="10" prefWidth="250" style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6; -fx-border-width: 0 1 0 0;">
            <padding><Insets top="20" right="15" bottom="20" left="15"/></padding>
            <ListView fx:id="scheduleListView" VBox.vgrow="ALWAYS"/>
        </VBox>
    </left>

    <center>
        <VBox>
            <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 10;">
                <Label fx:id="lblSelectedSchedule" text="No Schedule Selected"/>
            </HBox>

            <TabPane fx:id="roomTabPane" tabClosingPolicy="UNAVAILABLE"/>

            <ScrollPane fx:id="scrollPane" fitToWidth="false" fitToHeight="false" VBox.vgrow="ALWAYS">
                <content>
                    <VBox fx:id="mainContainer" spacing="0">
                        <HBox alignment="TOP_LEFT">
                             <Pane fx:id="spacerPane" /> 
                             <HBox fx:id="dayHeaderBox" style="-fx-background-color: white;"/>
                        </HBox>
                        <HBox alignment="TOP_LEFT">
                            <Pane fx:id="timeRulerPane" style="-fx-background-color: #f8f9fa;"/>
                            <StackPane alignment="TOP_LEFT">
                                <Pane fx:id="gridLinesPane" />
                                <Pane fx:id="eventsPane" />
                            </StackPane>
                        </HBox>
                    </VBox>
                </content>
            </ScrollPane>
        </VBox>
    </center>

    <bottom>
        <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-padding: 10; -fx-background-color: #34495e;">
            
            <Label fx:id="lblStatus" text="Ready" style="-fx-font-weight: bold; -fx-text-fill: white;"/>
            
            <Region HBox.hgrow="ALWAYS" />
            
            <Button fx:id="btnPrintSelected" text="Print Selected Schedule" onAction="#handlePrintSelected"
                    style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 5 15 5 15; -fx-background-radius: 4;"/>
        </HBox>
    </bottom>

</BorderPane>