<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.app.controller.ConfigController"
            stylesheets="@../css/style.css"
            prefHeight="600.0" prefWidth="900.0"> <center>
        <VBox spacing="10" styleClass="card-panel" style="-fx-padding: 15;">
            <StackPane>
                <Label text="Exam Sessions" styleClass="header-title"/>
            </StackPane>
            
            <TableView fx:id="courseTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colCourseCode" text="Course Code" prefWidth="100"/>
                    <TableColumn fx:id="colDuration" text="Duration" prefWidth="80" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colStudentCount" text="Students" prefWidth="80" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colEnrolledStudents" text="Enrolled IDs" prefWidth="250"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
            
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Label text="Raw Data:" styleClass="label-muted"/>
                <Button text="Students" onAction="#handleViewStudents" styleClass="button-base, button-small"/>
                <Button text="Rooms" onAction="#handleViewRooms" styleClass="button-base, button-small"/>
            </HBox>
        </VBox>
    </center>

    <right>
        <VBox spacing="10" prefWidth="280" styleClass="sidebar-panel"> <Label text="Global Settings" styleClass="section-title"/>
            
            <GridPane hgap="8" vgap="4">
                <columnConstraints>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                </columnConstraints>
                
                <Label text="Start Date:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="label-muted"/>
                <Label text="End Date:" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="label-muted"/>
                <DatePicker fx:id="dateStartDate" promptText="Start" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <DatePicker fx:id="dateEndDate" promptText="End" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                
                <Label text="Day Start:" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="label-muted"/>
                <Label text="Day End:" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="label-muted"/>
                <Spinner fx:id="spinDayStartTime" editable="true" maxWidth="Infinity" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <Spinner fx:id="spinDayEndTime" editable="true" maxWidth="Infinity" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                
                <Label text="Gap (min):" GridPane.rowIndex="4" GridPane.columnIndex="0" styleClass="label-muted"/>
                <Label text="Max/Day:" GridPane.rowIndex="4" GridPane.columnIndex="1" styleClass="label-muted"/>
                <Spinner fx:id="spinMinGap" editable="true" maxWidth="Infinity" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                <Spinner fx:id="spinMaxExams" editable="true" maxWidth="Infinity" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
            </GridPane>
            
            <Separator/>

            <VBox spacing="5" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Global Constraints" style="-fx-font-weight: bold;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnAddGlobalConstraint" text="+Add" onAction="#handleAddGlobalConstraint" styleClass="button-primary, button-small"/>
                </HBox>
                <ListView fx:id="listGlobalConstraints" VBox.vgrow="ALWAYS"/>
                <Button fx:id="btnRemoveGlobalConstraint" text="Remove Selected" onAction="#handleRemoveGlobalConstraint" maxWidth="Infinity" styleClass="button-danger"/>
            </VBox>

            <Separator/>

            <VBox spacing="5" VBox.vgrow="NEVER">
                <Label text="Course Settings" styleClass="section-title"/>
                <VBox spacing="5" styleClass="card-panel" style="-fx-padding: 8;">
                    <Label fx:id="lblSelectedCourse" text="Select a Course" style="-fx-text-fill: #2980b9; -fx-font-weight: bold;"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Duration:" styleClass="label-muted"/>
                        <Spinner fx:id="spinExamDuration" editable="true" maxWidth="80" disable="true"/>
                    </HBox>
                </VBox>
            </VBox>
            
            <Separator/>
            
            <VBox spacing="5" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Course Constraints" style="-fx-font-weight: bold;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnAddConstraint" text="+ Add" onAction="#handleAddConstraint" disable="true" styleClass="button-primary, button-small"/>
                </HBox>
                <ListView fx:id="listConstraints" VBox.vgrow="ALWAYS"/>
                <Button fx:id="btnRemoveConstraint" text="Remove Selected" onAction="#handleRemoveConstraint" maxWidth="Infinity" disable="true" styleClass="button-danger"/>
            </VBox>
            
            <Separator/>
            
            <Button fx:id="btnGenerate" text="GENERATE SCHEDULE" onAction="#handleGenerate" maxWidth="Infinity" prefHeight="40" styleClass="button-success"/>
        </VBox>
    </right>
</BorderPane>