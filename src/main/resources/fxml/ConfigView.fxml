<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.app.controller.ConfigController"
            prefHeight="650.0" prefWidth="1000.0">

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE" style="-fx-background-color: white;">
            <Tab text="Courses">
                <TableView fx:id="courseTable">
                    <columns>
                        <TableColumn fx:id="colCourseCode" text="Course Code" prefWidth="120" resizable="false"/>
                        <TableColumn fx:id="colEnrolledStudents" text="Enrolled Students (IDs)" prefWidth="400"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </Tab>
            
            <Tab text="Students">
                <TableView fx:id="studentTable">
                    <columns>
                        <TableColumn fx:id="colStudentId" text="Student ID" prefWidth="120" resizable="false"/>
                        <TableColumn fx:id="colEnrolledCourses" text="Enrolled Courses (Codes)" prefWidth="400"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </Tab>

            <Tab text="Rooms">
                <TableView fx:id="roomTable">
                     <columns>
                        <TableColumn fx:id="colRoomName" text="Room Name" prefWidth="120" resizable="false"/>
                        <TableColumn fx:id="colCapacity" text="Capacity" prefWidth="150"/>
                    </columns>
                </TableView>
            </Tab>
        </TabPane>
    </center>

    <right>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <content>
                <VBox spacing="15" prefWidth="340" 
                      style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6; -fx-border-width: 0 0 0 1;">
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>

                    <Label text="Global Settings" textFill="#2c3e50">
                        <font><Font name="System Bold" size="16.0"/></font>
                    </Label>
                    
                    <GridPane hgap="10" vgap="10">
                        <columnConstraints>
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="100"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                        
                        <Label text="Start Time:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <Spinner fx:id="spinDayStartTime" editable="true" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="End Time:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <Spinner fx:id="spinDayEndTime" editable="true" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                        
                        <Label text="Min Gap (min):" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <Spinner fx:id="spinMinGap" editable="true" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                    </GridPane>
                    
                    <Separator style="-fx-padding: 10 0;"/>

                    <Label text="Exam Configuration" textFill="#2c3e50">
                        <font><Font name="System Bold" size="16.0"/></font>
                    </Label>
                    
                    <VBox spacing="10">
                        <Label text="Select Course:" style="-fx-font-size: 12px;" textFill="#7f8c8d"/>
                        <ComboBox fx:id="comboCourses" promptText="Choose a course..." maxWidth="Infinity"/>
                        
                        <Label text="Exam Duration (minutes):" style="-fx-font-size: 12px;" textFill="#7f8c8d"/>
                        <Spinner fx:id="spinExamDuration" editable="true" maxWidth="Infinity"/>

                        <Separator style="-fx-padding: 5 0;"/>
                        
                        <Label text="Add Constraint (Optional):" style="-fx-font-size: 12px;" textFill="#7f8c8d"/>
                        <ComboBox fx:id="comboConstraintType" promptText="Rule Type..." maxWidth="Infinity"/>
                        
                        <VBox fx:id="dynamicInputBox" spacing="10">
                            <ComboBox fx:id="comboDay" promptText="Select Day" visible="false" maxWidth="Infinity"/>
                            <TextField fx:id="txtTimeStart" promptText="Start Time (e.g. 13:30)" visible="false"/>
                            <TextField fx:id="txtTimeEnd" promptText="End Time (e.g. 15:00)" visible="false"/>
                            <TextField fx:id="txtRoomName" promptText="Room Name" visible="false"/>
                        </VBox>
                        
                        <Button fx:id="btnAddConstraint" text="Save Configuration" onAction="#handleSaveConfig" maxWidth="Infinity"
                                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold;"/>
                    </VBox>
                    
                    <Separator style="-fx-padding: 10 0;"/>
                    
                    <VBox spacing="5" VBox.vgrow="ALWAYS">
                        <Label text="Active Configurations" textFill="#2c3e50">
                            <font><Font name="System Bold" size="14.0"/></font>
                        </Label>
                        <ListView fx:id="listConstraints" prefHeight="150" style="-fx-background-radius: 4;"/>
                        <Button fx:id="btnRemoveConstraint" text="Remove Selected" onAction="#handleRemoveConstraint" maxWidth="Infinity"
                                style="-fx-text-fill: #c0392b; -fx-background-color: white; -fx-border-color: #c0392b; -fx-border-radius: 4; -fx-cursor: hand;"/>
                    </VBox>

                    <Separator style="-fx-padding: 10 0;"/>
                    
                    <Button fx:id="btnGenerate" text="GENERATE SCHEDULE" onAction="#handleGenerate"
                            maxWidth="Infinity" prefHeight="50"
                            style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-cursor: hand;"/>
                </VBox>
            </content>
        </ScrollPane>
    </right>
</BorderPane>